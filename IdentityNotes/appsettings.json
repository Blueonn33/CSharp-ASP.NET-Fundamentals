{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=IdentityNotes;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "IdentityNotesDbContext": "Server=(localdb)\\mssqllocaldb;Database=IdentityNotesDbContext;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Password": {
      "RequireDigit": false,
      "RequiredUniqueChars": 0,
      "RequireNonAlphanumeric": false,
      "RequiredLength": 3
    },
    "SignIn": {
      "RequireConfirmedAccount": false
    },
    "User": {
      "RequireUniqueEmail": true
    }
  }
}