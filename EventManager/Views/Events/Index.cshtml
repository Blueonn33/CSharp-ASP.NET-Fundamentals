@model EventIndexPageViewModel

@{
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Events</h1>
        <div class="text-muted">Browse upcoming events and register in seconds
        </div>
    </div>
    
    <a class="btn btn-primary" asp-controller="Events" asp-action="Create">
        + Create Event
    </a>
</div>

<form asp-controller="Events" asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-6 col-lg-3">
            <label asp-for="Title" class="form-label">Title</label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <label asp-for="CategoryId" class="form-label">Category</label>
            <select asp-for="CategoryId" class="form-select">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-6 col-lg-2">
            <label asp-for="StartDateFrom" class="form-label">Start date from</label>
            <input asp-for="StartDateFrom" type="date" class="form-control" />
        </div>
        <div class="col-12 col-md-6 col-lg-2">
            <label asp-for="StartDateTo" class="form-label">Start date to</label>
            <input asp-for="StartDateTo" type="date" class="form-control" />
        </div>
        <div class="col-12 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a class="btn btn-outline-secondary" asp-controller="Events" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="alert alert-info">
        No events match your filters.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var ev in Model.Events)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title mb-1">@ev.Title</h5>
                            <span class="badge bg-secondary">@ev.CategoryName</span>
                        </div>
                        
                        @if (!string.IsNullOrWhiteSpace(ev.Description))
                        {
                            <p class="card-text text-muted mt-2">
                                @(ev.Description!.Length > 120 ? ev.Description.Substring(0,120) + "..." : ev.Description)
                            </p>
                        }
                        else
                        {
                            <p class="card-text text-muted mt-2 fst-italic">No description</p>
                        }
                        
                        <ul class="list-unstyled small mb-0">
                            <li><strong>Start:</strong> @ev.StartDate
                            </li>
                            <li><strong>End:</strong> @ev.EndDate
                            </li>
                            <li><strong>Participants:</strong> @ev.CurrentParticipants / @ev.MaxParticipants
                            </li>
                        </ul>
                    </div>
                    
                    <div class="card-footer bg-white border-0 pt-0">
                        <div class="d-flex gap-2">
                            <a class="btn btn-outline-primary w-100"
                               asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@ev.Id">
                                Details
                            </a>
                            
                            <a class="btn btn-outline-success w-100"
                               asp-controller="Registrations"
                               asp-action="Create"
                               asp-route-eventId="@ev.Id">
                                Register
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
}